# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Bot Identity Configuration (Optional)
# These values are used as template variables in prompt_storage files
# BOT_NAME=Bad Kitty                    # Bot's display name (used in {botName} template variable)
# BOT_FAMILY_NAME=Lumias                # Shared bot-family label (used in {bot_family} / {botFamily} template variables)
# BOT_OWNER_NAME=Prolix                 # Owner's name (used in {ownerName} template variable)
# REQUIRED for owner-only commands (memory wipes, global config changes, and
# /ratelimit or /boredom when no TRUSTED_ROLE_IDS are set). There is NO default
# owner: leave it unset and EVERY owner-only gate silently denies for everyone —
# no error at the call site. The bot still starts and chats normally, it just has
# no owner, and validateConfig() logs a loud warning at boot.
# OWNER_ID=123456789012345678           # Your Discord user ID
# BOT_OWNER_ID=123456789012345678       # Legacy owner ID env var; OWNER_ID takes precedence
# BOT_OWNER_USERNAME=prolix_oc          # Owner's Discord username (used in {ownerUsername} template variable)
# NSFW_ONLY=false                       # When true, the bot only responds/acts in channels marked NSFW. Also unlocks NSFW image generation for ANY user in those channels (drops the owner-only check, since the whole bot is already age-gated)

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: Custom API base URL (e.g., for OpenRouter, Together AI)
OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_ALIAS=gpt-4o-mini  # Optional: Map to a different model name for the provider
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=1  # Controls randomness (0-2). Higher = more random. Default: 1
OPENAI_TOP_P=0.95  # Nucleus sampling (0-1). Default: 0.95
OPENAI_TOP_K=0  # Top-k sampling. 0 = disabled. Default: 0 (only supported by some APIs)
OPENAI_FILTER_REASONING=true  # Filter out reasoning content from responses (e.g., o1/o3 models)
# OPENAI_VIDEO_ENABLED=true  # Enable sending video as base64 via OpenAI-compatible APIs (Moonshot, OpenRouter, etc.)
# OPENAI_EXTRA_BODY={"chat_template_kwargs":{"thinking":false}}  # Optional: JSON object passed directly to API request body
# OPENAI_RAW_BODY_PARAMS={"thinking":{"type":"disabled"}}  # Optional: JSON object merged directly into request body (not wrapped in extra_body). Use for provider-specific params like Moonshot's thinking control
# Per-HTTP-request timeout for the OpenAI-compatible SDK, in ms (5000-600000).
# The SDK's own retries are disabled, so backoff is owned solely by this bot's
# retry loop rather than being applied twice at two layers. Raise it for slow
# local models (Ollama, vLLM), lower it to fail over to the next provider
# sooner. Default: 120000.
# OPENAI_REQUEST_TIMEOUT_MS=120000
# Wall-clock budget for one whole chat turn — every attempt and every tool
# round combined, in ms (30000-900000). Once it is spent, the remaining tool
# rounds are abandoned instead of being allowed to run, so a tool loop cannot
# pin a channel's serialisation slot indefinitely. Keep it comfortably above
# OPENAI_REQUEST_TIMEOUT_MS so a single slow request is not the thing that
# trips it. Default: 180000.
# OPENAI_TURN_DEADLINE_MS=180000

# Thinking / Reasoning Configuration
# THINKING_ENABLED=true  # Enable interleaved thinking for supported models (default: true)
                         # When true: Gemini uses MEDIUM/HIGH thinking, DeepSeek/Moonshot auto-configure,
                         #            Google GenAI tools use AUTO mode (model decides when to call tools)
                         # When false: All models use minimal/disabled thinking,
                         #             Google GenAI tools use ANY mode (forced tool calls)

# SearXNG Configuration
# REQUIRED. validateConfig() throws at boot if this is unset, so a copy of this
# file that leaves it commented out will not start. Point it at a real instance
# (public or self-hosted); the built-in default is the placeholder
# https://search.example.com, which does not resolve to anything useful.
SEARXNG_URL=https://search.example.com
# SEARXNG_MAX_RESULTS=5    # Results kept per search (1-100)
# SEARXNG_SAFE_SEARCH=1    # 0 = off, 1 = moderate, 2 = strict

# Server Configuration
PORT=3000

# ---------------------------------------------------------------------------
# Data files
# ---------------------------------------------------------------------------
# Where the SQLite databases (*.db) live. Defaults to this repo's data/ folder.
# A relative value is resolved from the repo root, NOT from the directory you
# ran `bun` from, so a script started elsewhere still opens the same database.
#
# UPGRADING FROM AN OLDER VERSION? Older versions opened these files with a bare
# CWD-relative name (`new Database('user_memories.db')`), which put them next to
# wherever you happened to start the bot. If yours are still there, this version
# will not see them — and because SQLite silently creates a new empty file when
# one is missing, the upgrade will *succeed* and simply come up with no memories
# and no knowledge documents. On the first start after upgrading, the bot prints
# a loud warning naming each stranded file. Fix it by either:
#
#   mv /path/to/old/user_memories.db ./data/     # move it into DATA_DIR
#   # ...or leave it alone and point this variable at its parent instead:
#   DATA_DIR=/path/to/old
#
# Nothing is moved or deleted for you — a wrong automatic move could clobber a
# copy you kept on purpose.
# DATA_DIR=./data

# ---------------------------------------------------------------------------
# Server-side media fetching
# ---------------------------------------------------------------------------
# Hosts this bot is willing to download media from when a Discord message or
# embed points at them. Discord lets `embed.image.url` / `embed.video.url` be an
# arbitrary URL on ANY host, and the bot has to fetch those bytes itself — CDN
# links carry an auth token the model vendor cannot use, so they are base64
# inlined into the outbound API request.
#
# READ THIS BEFORE ADDING A HOST. Anything listed here is fetched by this
# machine, inside your network, with this process's reach — and the bytes are
# then forwarded to a third-party model vendor, which frequently narrates them
# back into the channel. Any member of any guild the bot is in can put a URL in
# an embed, so a listed host becomes reachable by anyone who can post. Only add
# a host you would be happy to have fetched on a user's say-so.
#
# The value is the whole list, not an addition to it: set it and the defaults
# are replaced, so keep the Discord entries unless you intend to stop fetching
# Discord attachments. Wildcards match sub-domains on a dot boundary
# (`*.discordapp.com` matches `cdn.discordapp.com` and `cdn-eu.discordapp.com`
# but not `discordapp.com`); a bare host also matches its own sub-domains.
# Entries that are not a host (a scheme, a port, a path) are ignored with a
# warning. Entries are only checked against private/internal name suffixes and
# the scheme/userinfo rules — a listed host is trusted at your discretion.
#
# Needed if you use Tenor/Giphy `gifv` embeds, whose `video.url` is
# `media.tenor.com` / `media.giphy.com` rather than a Discord host and is
# otherwise dropped.
# DISCORD_MEDIA_ALLOWED_HOSTS=*.discordapp.com,*.discordapp.net

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
# Largest text file that is read into the prompt, in KB. This is a context
# overflow / cost guard, not a preview size — raising it buys you crashes.
# ATTACHMENTS_MAX_TEXT_SIZE_KB=25

# ---------------------------------------------------------------------------
# Video (OpenAI-compatible video understanding / ffmpeg pipeline)
# ---------------------------------------------------------------------------
# IMPORTANT on Termux/Android: ffmpeg-static resolves to null there because the
# bundled binary cannot run, so ALL GIF and video processing is inert until you
# point this at a working ffmpeg (e.g. `pkg install ffmpeg` gives
# /data/data/com.termux/files/usr/bin/ffmpeg). Unset on platforms where
# ffmpeg-static works fine.
# FFMPEG_PATH=/data/data/com.termux/files/usr/bin/ffmpeg
# Largest video that will be processed, in MB. Larger uploads are refused
# rather than silently transcoded at full size.
# VIDEO_MAX_SIZE_MB=50
# Output height. 480 is cheapest, 1080 is sharpest and slowest.
# VIDEO_TARGET_RESOLUTION=720
# Constant-rate factor: 18 is near-lossless, 28 is small. Lower = better quality
# and a bigger file; 18-28 is the sensible range.
# VIDEO_CRF=23
# Hard cap on input duration, in seconds, handed to ffmpeg as `-t` — so it
# truncates rather than transcodes up to. Without it a long clip keeps the
# encoder busy for minutes and can outlive the request that started it. The
# default (60) is deliberately conservative: ffmpeg is CPU-saturating and this
# bot runs on a phone. Raise it only if you know you want to pay that.
# VIDEO_MAX_INPUT_SECONDS=60

# ---------------------------------------------------------------------------
# Page extraction (fetching URLs that appear in chat)
# ---------------------------------------------------------------------------
# PAGE_EXTRACTION_ENABLED=true            # Set to false to never fetch URLs
# PAGE_EXTRACTION_MAX_URLS=3              # Max pages fetched per message
# PAGE_EXTRACTION_MAX_CONTENT_KB=50       # Max text kept per page, in KB
# PAGE_EXTRACTION_TIMEOUT_MS=10000        # Per-request timeout in ms

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# One request per RATE_LIMIT_SECONDS window, per user. Owner is always exempt.
# The minimum is 1 second, which still allows one request per second — set a
# large value to effectively disable limiting. /ratelimit set overrides this and
# is persisted, so it survives a restart.
# RATE_LIMIT_SECONDS=60
# Rate-limit bypass only: role IDs or exact role names (case-insensitive) whose
# holders get more of their own chat quota. This list authorises NOTHING — it
# cannot run /ratelimit or /boredom. Names are safe here precisely because the
# grant is self-limiting (one member of one guild is not throttled).
# The two lists are deliberately separate; do not merge them.
# RATE_LIMIT_EXEMPT_ROLES=123456789012345678,Moderator

# Command authorisation: comma-separated Discord role SNOWFLAKES ONLY that may
# run the privileged mod commands (/ratelimit, /boredom). These commands write
# global bot state, so they cannot be authorised by a role NAME — any guild
# admin can mint a role called "Moderator" and hand themselves global control
# (and a bill). Non-numeric entries are rejected and logged at boot, granting
# nothing. Use TRUSTED_ROLE_IDS for authority and RATE_LIMIT_EXEMPT_ROLES for
# the quota bypass.
# Numeric IDs already in RATE_LIMIT_EXEMPT_ROLES are still honoured for these
# commands (with a one-time warning about any name entries); names are not.
# Empty means /ratelimit and /boredom are owner-only.
# TRUSTED_ROLE_IDS=123456789012345678,987654321098765432
# Application emoji reacted to rate-limited messages. Use a Developer Dashboard
# application emoji name (no <name:id> wrapper needed) or a unicode emoji.
# RATE_LIMIT_EMOJI=rate_limited

# ---------------------------------------------------------------------------
# Boredom (unprompted chatter in specific channels)
# ---------------------------------------------------------------------------
# Comma-separated channel IDs where the bot may start conversations on its own.
# Empty (the default) means the feature is off everywhere.
# BOREDOM_CHANNELS=123456789012345678,987654321098765432
# Random delay between unprompted messages. The actual wait is picked somewhere
# between these two, so a fixed interval is not guessable. Defaults: 60 / 240.
# BOREDOM_MIN_MINUTES=60
# BOREDOM_MAX_MINUTES=240
# Show the typing indicator while the bot composes an unprompted message.
# BOREDOM_SHOW_TYPING=false
# How many recent messages of context to consider when picking a topic.
# BOREDOM_HISTORY_LIMIT=15

# ---------------------------------------------------------------------------
# Dashboard (mobile web UI + JSON API)
# ---------------------------------------------------------------------------
# Binds to 127.0.0.1 by default, so it is only reachable from the device itself
# and is not exposed to your network. Open http://localhost:3001 in your phone's
# browser. Set DASHBOARD_HOST=0.0.0.0 to reach it from another device on your LAN.
# DASHBOARD_ENABLED=true
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=3001  # Separate from PORT so it never collides with ORCHESTRATOR_URL (default ws://localhost:3000)

# REQUIRED. The dashboard refuses to start at all without it, on any bind
# including loopback: it exposes full transcripts and the system prompt, and on
# Android every app on the device can reach 127.0.0.1, so loopback is not a
# boundary here. Use a long random string, not a word you would type on a public
# keyboard. To run without a dashboard, set DASHBOARD_ENABLED=false instead.
# DASHBOARD_PASSWORD=change-me-to-a-long-random-string
# DASHBOARD_USERNAME=admin

# Optional absolute origin the dashboard is also served under, e.g.
# http://192.168.1.44:3001. When set it becomes the only accepted Origin for
# state-changing requests, instead of one reconstructed from request headers
# (a Host/X-Forwarded-Proto pair is exactly what DNS rebinding controls), and it
# is added to the Host allowlist. Needed if you bind DASHBOARD_HOST to a LAN
# address and want to reach it by that address.
# DASHBOARD_PUBLIC_ORIGIN=http://192.168.1.44:3001

# Rolling window sizes shown on the dashboard
# DASHBOARD_LOG_WINDOW_HOURS=12
# DASHBOARD_USAGE_WINDOW_HOURS=24

# Max interactions kept in the in-memory prompt/response log
# DASHBOARD_LOG_MAX_ENTRIES=500

# Your provider's requests-per-day ceiling, used to render the usage bar.
# Set to 0 (default) to just show a raw count.
# LLM_DAILY_REQUEST_LIMIT=500

# Models the dashboard may switch between, as a comma-separated list. When this
# is empty the in-app switcher stays hidden and the model is fixed by
# OPENAI_MODEL. The selection made in the dashboard is persisted, so you can
# leave OPENAI_MODEL commented out and drive the model entirely from the UI.
# DASHBOARD_MODEL_OPTIONS=gpt-4o,kimi-k2-thinking,gemini-3-flash

# ---------------------------------------------------------------------------
# Health check (unauthenticated liveness ping)
# ---------------------------------------------------------------------------
# A second, tiny HTTP listener that answers GET/HEAD on / and /healthz with 200
# and nothing else. There is NO auth on it, and it never touches the dashboard's
# auth machinery.
#
# Point uptime monitors (Dashy, Uptime Kuma, etc.) at THIS port and never at the
# dashboard URL. Every credential-less request to the dashboard counts as an auth
# failure against that source IP; after 5 of them the server answers 429 with a
# doubling backoff up to 120 seconds, so a monitor polling the dashboard trips
# the brute-force lockout and locks you out of your own dashboard.
#
# Disabled unless you set a port: 0 (the default) means nothing new listens.
# HEALTH_PORT=3002
# HEALTH_HOST=127.0.0.1  # set to 0.0.0.0 only if the monitor runs on another machine
# HEALTH_ENABLED=true

# The response is ALWAYS 200, even while the bot is starting or restarting.
# `discord` is informational only and never changes the status code, so a
# monitor cannot false-alarm during a restart:
#   {"status":"ok","uptimeSeconds":1234,"discord":"ready","serverTime":"2026-10-03T00:00:00.000Z"}
#
# It logs nothing per request: one line at startup with its URL, plus an extra
# warning if you bind it to a non-loopback host. Unlike the dashboard it does NOT
# step forward to the next port when HEALTH_PORT is busy — it logs one error and
# stays down, because silently hopping would point your monitor at nothing while
# still looking healthy.
#
# It exposes liveness and uptime only: no bot name, no guild names, no
# transcripts, no prompts, no keys. Still, anyone who can route to HEALTH_HOST
# can reach it, so keep it on 127.0.0.1 unless you specifically need remote access.

# ─────────────────────────────────────────────────────────────────────────────
# Prompt profiles
# ─────────────────────────────────────────────────────────────────────────────
# A PROFILE IS A FOLDER OF PROMPT FILES.
#
#   prompt_storage/                      ← the "default" profile, always present
#   prompt_storage/profiles/<id>/…        ← an extra profile, e.g. "big-rpd"
#
# Only the files a profile actually contains are overridden; everything else
# falls back to the default profile, per file. So a profile holding just
# persona/identity.txt changes the bot's persona and inherits the guidelines,
# instructions, triggers and JSON configs from prompt_storage/ as normal. You
# do not have to copy the whole tree.
#
# The profile in effect is, in order of precedence:
#
#   1. the manual override picked in the dashboard
#   2. the profile bound to the current model (MODEL_PROMPT_PROFILES below)
#   3. "default"
#
# PROMPT_PROFILES is the WHITELIST of ids the dashboard may activate, as a
# comma-separated list. Anything not listed here can never be activated, even
# if a model binding names it. Ids may contain letters, digits, dot, dash and
# underscore, and must start with a letter or digit. Leaving this unset turns
# the feature off: the bot behaves exactly as before, using "default".
#
# The selection made in the dashboard is persisted, so it survives turning the
# bot off and on.
#
# ⚠️ CHANGING THE MODEL CLEARS THE MANUAL OVERRIDE.
#
# This is deliberate, and it surprises people, so: switching model in the
# dashboard (or resetting it back to OPENAI_MODEL) drops any prompt profile you
# picked by hand and goes back to the profile bound to the new model — or to
# "default" if that model has no binding. The reasoning is that the override is
# an exception to the model's configuration, not a separate setting. If you want
# a profile to survive model switches, bind it to the model instead
# (MODEL_PROMPT_PROFILES), because bindings are re-applied on every switch.
# PROMPT_PROFILES=default,big-rpd,nsfw-heavy
#
# Bind a default prompt profile to a model, as comma-separated model=profile
# pairs, using the same ids as PROMPT_PROFILES. A model with no entry here uses
# "default".
#
# An entry naming a profile that PROMPT_PROFILES does not allow is a
# configuration error: it is dropped at startup with a loud warning (it could
# never be activated), and that model falls back to "default". Malformed
# entries are dropped with a warning too. Startup also reports any profile name
# with no matching folder on disk, so a typo shows up in the log instead of
# silently doing nothing.
# MODEL_PROMPT_PROFILES=kimi-k2-thinking=big-rpd,gemini-3-flash=big-rpd

# Conversation History Configuration
CONVERSATION_MAX_HISTORY=20  # Maximum number of messages to keep per user (rolling window)

# Channel History Configuration
CHANNEL_MAX_HISTORY=20  # Maximum number of recent channel messages to include in context

# Google GenAI Configuration (Optional - for direct Gemini API access)
# Use this when running Gemini 3 models directly through Google's API instead of via OpenAI proxy
# GEMINI_API_KEY=your_gemini_api_key_here  # Get from https://ai.google.dev/
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com  # Optional: Custom Gemini API endpoint
# Per-HTTP-request timeout for the Google GenAI SDK, in ms (5000-600000). As
# with OpenAI, SDK-internal retries are off so this bot's retry loop is the only
# thing applying backoff. Default: 120000.
# GEMINI_REQUEST_TIMEOUT_MS=120000
# Wall-clock budget for one whole turn across all attempts and tool rounds, in
# ms (30000-900000); remaining tool rounds are abandoned once it is spent. Keep
# it above GEMINI_REQUEST_TIMEOUT_MS. Default: 180000.
# GEMINI_TURN_DEADLINE_MS=180000

# Vision Secondary Model Configuration (Optional)
# Use a separate model for vision tasks when the main model doesn't support vision
# The vision model processes images/videos and feeds the description to the main model
# VISION_SECONDARY_MODEL=gpt-4o-mini                    # Model to use for vision tasks
# VISION_SECONDARY_PROVIDER=openai                      # 'openai' or 'gemini'
# VISION_SECONDARY_API_KEY=                             # Optional: different API key (defaults to main provider key)
# VISION_SECONDARY_BASE_URL=                            # Optional: different endpoint (defaults to main provider URL)
# VISION_SECONDARY_MAX_TOKENS=2000                      # Max tokens for vision model responses
# VISION_SECONDARY_TEMPERATURE=1                        # Temperature for vision model (0-2)
# VISION_SECONDARY_PROMPT_PREFIX="Describe what you see in this image in detail:"  # Prompt prefix for vision requests

# Spotify Configuration (Optional - for music playlist import)
# Get credentials from: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Ceiling on playlist items pulled from Spotify (1-10000). The cap is on the
# pagination cursor (items the API offers), NOT on how many usable tracks
# survive filtering, so removed/local tracks can no longer extend the loop.
# SPOTIFY_MAX_PLAYLIST_TRACKS=1000
# Artist ids per genre lookup (1-50; Spotify's documented maximum is 50).
# SPOTIFY_ARTIST_BATCH_SIZE=50
# Longest wait honoured for a Spotify 429 Retry-After before giving up on a
# batch (0-60000). Above it, the import fails instead of stalling a turn.
# SPOTIFY_RATE_LIMIT_MAX_WAIT_MS=10000

# Music import tuning
# Playlist-import rows inserted between event-loop yields (1-1000). bun:sqlite is
# synchronous, so a naive loop pins the single thread and the gateway stops
# heartbeating. Lower = smoother but slower; default 25.
# MUSIC_IMPORT_YIELD_EVERY=25
# How long SQLite waits on a locked database before returning SQLITE_BUSY
# (0-60000). Default 5000.
# MUSIC_DB_BUSY_TIMEOUT_MS=5000

# Navidrome Configuration (Optional - for checking current playback over Subsonic API)
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_USER=your_navidrome_username
# NAVIDROME_PASSWORD=your_navidrome_password

# Enable orchestrator integration (set to 'true' to enable)
# ORCHESTRATOR_ENABLED=true

# Orchestrator WebSocket URL (where the orchestrator server is running).
# The connection is REFUSED unless the URL is wss://, with exactly two
# exceptions: a loopback host (localhost/127.0.0.1/::1) or
# ORCHESTRATOR_ALLOW_INSECURE=true. The shared API key is sent as a plaintext
# header on every reconnect, so a cleartext hop over a shared LAN or a phone
# hotspot hands that key to anyone on-path, who can then drive this bot.
# Prefer wss:// (a tunnel or reverse proxy) and leave the flag unset.
# ORCHESTRATOR_URL=wss://orchestrator.example.com
# Deliberate opt-in to a non-loopback cleartext ws:// peer. Default false, and
# the orchestrator logs a loud warning while it is set. Only use it for a peer
# you already trust at the transport layer.
# ORCHESTRATOR_ALLOW_INSECURE=false

# API key for authenticating with the orchestrator (must match orchestrator's API_KEY)
# ORCHESTRATOR_API_KEY=your-orchestrator-api-key

# Orchestrator turn journal retention
# Turns older than this are deleted by a periodic sweep (1-3650 days). The
# journal suppresses duplicate responses, so this bounds its disk growth.
# ORCHESTRATOR_TURN_RETENTION_DAYS=14
# How often that sweep runs, in minutes (1-1440). Default 360 (6 hours).
# ORCHESTRATOR_TURN_SWEEP_INTERVAL_MINUTES=360

# Unique bot identifier for the orchestrator (defaults to DISCORD_CLIENT_ID)
# ORCHESTRATOR_BOT_ID=bot-unique-id

# Bot name for the orchestrator (defaults to BOT_NAME)
# ORCHESTRATOR_BOT_NAME=LumiaBot-Alpha

# Shared council-family label for orchestrated sessions (defaults to BOT_FAMILY_NAME)
# COUNCIL_FAMILY_NAME=Lumias

# Council display name used in orchestrated sessions and in the {councilName}
# template variable. Takes precedence over COUNCIL_FAMILY_NAME, which takes
# precedence over BOT_FAMILY_NAME.
# COUNCIL_NAME=Lumias

# Whether this bot votes when the orchestrator assembles a council answer.
# Set to false for a bot that should be consulted but not decide.
# ORCHESTRATOR_COUNCIL_PARTICIPANT=true

# Knowledge graph source mode
# 0 = local bot knowledge only
# 1 = orchestrator knowledge + connected peer bots only
# 2 = both local bot knowledge and orchestrator-backed collective knowledge
# KNOWLEDGE_GRAPH_SOURCE_MODE=0

# Reconnection settings
# ORCHESTRATOR_RECONNECT_INTERVAL=5000
# ORCHESTRATOR_MAX_RECONNECT=10

# ---------------------------------------------------------------------------
# One-off scripts (not read by the running bot)
# ---------------------------------------------------------------------------
# Root of the Lumiverse-Backend checkout, used only by
# `bun run src/scripts/import-lumiverse-docs.ts` to import that project's docs
# into the knowledge graph. Defaults to $HOME/Projects/Lumiverse-Backend, so on
# any machine where the checkout is not there this is the override.
# LUMIVERSE_ROOT=/path/to/Lumiverse-Backend
